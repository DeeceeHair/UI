<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/solar_gray_100"
    tools:context=".CategoryFragment">

    <!-- In a real app, this would be a RecyclerView -->
    <TextView
        style="@style/TextAppearance.MaterialComponents.Body1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/category_item_background"
        android:drawableStart="@drawable/ic_category_nebulae"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="Nebulae"
        android:textColor="@color/solar_gray_900"
        android:layout_marginBottom="16dp"/>

    <TextView
        style="@style/TextAppearance.MaterialComponents.Body1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/category_item_background"
        android:drawableStart="@drawable/ic_category_stars"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="Stars &amp; Constellations"
        android:textColor="@color/solar_gray_900"
        android:layout_marginBottom="16dp"/>

</LinearLayout>

